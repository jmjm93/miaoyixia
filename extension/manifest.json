{
  "manifest_version": 3,
  "name": "miaoyixia — Chinese hover dictionary",
  "version": "0.1.0",
  "description": "Hover a Chinese word and press Shift for pinyin and definitions. Fully offline, powered by CC-CEDICT.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://commons.wikimedia.org/*",
    "https://upload.wikimedia.org/*"
  ],
  "optional_host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/content/text-at-point.js",
        "src/content/speech.js",
        "src/content/popup.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/content/popup.css"],
      "matches": ["<all_urls>"]
    }
  ],
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "zh-dic settings"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
